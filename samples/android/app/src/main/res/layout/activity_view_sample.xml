<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the Activity's content FrameLayout. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- The id lets the view retain its controller (and markers) across rotation. -->
    <com.remaply.maps.RemaplyMapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:remaply_styleUrl="https://tiles.openfreemap.org/styles/liberty" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#E6FFFFFF"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_loading"
            android:textColor="#FF202124" />

        <LinearLayout
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                style="?android:attr/buttonBarButtonStyle"
                android:id="@+id/animate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_animate" />

            <Button
                style="?android:attr/buttonBarButtonStyle"
                android:id="@+id/reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_reset" />
        </LinearLayout>
    </LinearLayout>
</merge>
