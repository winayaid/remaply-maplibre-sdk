<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      MapLibre declares location permissions for its location component. v1 of this SDK does not use
      location (API_SPEC.md §13.1), so they are removed from apps that use the SDK. An app that enables
      location through the experimental withNativeMap escape hatch declares them in its own manifest.
      INTERNET and ACCESS_NETWORK_STATE come from MapLibre and are kept.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        tools:node="remove" />

</manifest>
